#
# name: simple begin as expression on RHS of setvar
#====================================================================


#====================================================================
# name: begin as expression on RHS of setvar [ghi]
# `$x = begin ... end` uses the block's value; last body expression is the value
#

#--- code -----------------------------------------------------------
$x = begin
	$a = 10
	$b = 20
	$c = $a + $b
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"begin_end": {
				"body": [
					[
						"scope",
						"setvar",
						"a",
						{
							"line": 2,
							"value": 10
						},
						{
							"line": 2
						}
					],
					[
						"scope",
						"setvar",
						"b",
						{
							"line": 3,
							"value": 20
						},
						{
							"line": 3
						}
					],
					[
						"scope",
						"setvar",
						"c",
						{
							"left": {
								"line": 4,
								"var": "a"
							},
							"line": 4,
							"op": "+",
							"right": {
								"line": 4,
								"var": "b"
							}
						},
						{
							"line": 4
						}
					]
				]
			}
		},
		{
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "begin",
		"syn": true,
		"block": [
			{
				"frame": true,
				"fn": "=",
				"syn": true,
				"args": ["a", [{"primitive": 10}]]
			},
			{
				"frame": true,
				"fn": "=",
				"syn": true,
				"args": ["b", [{"primitive": 20}]]
			},
			{
				"frame": true,
				"fn": "=",
				"syn": true,
				"args": [
					"c",
					[
						{
							"var": "a",
							"fn": "+",
							"syn": true,
							"args": [[{"var": "b"}]]
						}
					]
				]
			}
		]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: begin as expression on RHS of setvar
#====================================================================


#====================================================================
# name: begin with as $block controller [ghi]
# `$block.return VALUE` exits early; block value is the returned value
#

#--- code -----------------------------------------------------------
$result = begin as $block
	$block.return 'whatever'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"result",
		{
			"begin_end": {
				"as": "block",
				"body": [
					[
						{
							"args": [
								{
									"line": 2,
									"value": "whatever"
								}
							],
							"left": {
								"var": "block"
							},
							"line": 2,
							"op": ".",
							"right": "return"
						}
					]
				]
			}
		},
		{
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "begin",
		"syn": true,
		"as": "block",
		"block": [
			{
				"var": "block",
				"fn": "return",
				"args": [[{"primitive": "whatever"}]]
			}
		]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["result", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: begin with as $block controller
#====================================================================


#====================================================================
# name: begin with ensure clause [ghi]
# `ensure` runs on all exit paths — clause slot added on demand (not in the default 5-clause set) so an atom without a declared `ensure` doesn't carry an empty slot
#

#--- code -----------------------------------------------------------
begin
	puts 'in body'
ensure
	puts 'always runs'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"begin_end": {
				"body": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 2,
							"value": "in body"
						},
						{
							"line": 2
						}
					]
				],
				"ensure": [
					[
						{
							"bwc": "puts"
						},
						{
							"line": 4,
							"value": "always runs"
						},
						{
							"line": 4
						}
					]
				]
			},
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "begin",
		"syn": true,
		"block": [
			{
				"bwc": "puts",
				"args": [[{"primitive": "in body"}]]
			}
		],
		"ensure": [
			{
				"bwc": "puts",
				"args": [[{"primitive": "always runs"}]]
			}
		]
	}
]
#--------------------------------------------------------------------

#
# name: begin with ensure clause
#====================================================================


