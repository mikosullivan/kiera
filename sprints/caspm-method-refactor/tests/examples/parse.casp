#
# name: caller `.wants_controller?` introspection idiom
#====================================================================


#====================================================================
# name: closure with `as $loop` controller binding [ghi]
# `as $loop` on the closure opener is signature metadata — lifted to an
# `as: "loop"` field on the closure atom, NOT captured as a body statement.
# The runtime uses this field via `$caller.wants_controller?` to know
# whether the target asked for a loop-controller. Same rewrite applies
# to `function &foo() as $l`, `method &foo() as $l`, `do(...) as $l`,
# `while ... as $loop`, `until ... as $loop`, and `begin ... as $block`.
#

#--- code -----------------------------------------------------------
$foo = closure($idx) as $loop
	puts $loop.index
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"foo",
		{
			"closure": {
				"as": "loop",
				"body": [
					[
						{
							"bwc": "puts"
						},
						{
							"left": {
								"line": 2,
								"var": "loop"
							},
							"line": 2,
							"op": ".",
							"right": "index"
						},
						{
							"line": 2
						}
					]
				],
				"params": [
					"idx"
				]
			}
		},
		{
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		{
			"cmd": "="
		},
		"foo",
		{
			"cl": {
				"as": "loop",
				"bd": [
					[
						{
							"bwc": "puts"
						},
						[
							{
								"cmd": "mc"
							},
							{
								"fn": "index",
								"rcvr": {
									"var": "loop"
								}
							}
						]
					]
				],
				"pm": [
					"idx"
				]
			}
		},
		{
		}
	]
]
