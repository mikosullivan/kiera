# Weird stuff
#====================================================================

#====================================================================
# name: nested long-form function assignment with rich-metadata param whose default is another function [ghi]
# every source comment preserved
#

#--- code -----------------------------------------------------------
$foo = function( # outer function
	# first and only param for outer function
	$myfunc: {
			# set param as optional
			optional: true,

			# next param, which defaults to a function
			default: function($port: {'default':80}) # function as default param
