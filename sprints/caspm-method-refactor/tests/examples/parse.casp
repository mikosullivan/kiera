#!/usr/bin/caspian

vibecode <<EOF
{
	"doc": "test_cases_parsing_parse",
	"role": "test bed for the Caspian to CaspianJ transpiler — exercises syntactic constructs and asserts each one's CaspianJ shape. Test-case format: each fixture is boxed by `#===...` outer borders around a `# name: LABEL` header, then two inner sections `#--- code ---` (the Caspian source) and `#--- full ---` (the expected full-format CaspianJ, pretty-printed — JSON is itself valid Caspian). Each section ends at a bare `#-----...` closer. The extractor at tests/main/lua/transpiler/parse_extract.lua reads these and hands them to busted; anything outside a fixture (section dividers, prose, `# deferred: ...` blocks) is documentation and never reaches the transpiler.",
	"status": "growing; language surveys get promoted to fixtures as their CaspianJ shapes are settled"
}
EOF


#====================================================================
# Comments and whitespace
#====================================================================


#====================================================================
# name: assignment with end-of-line comment [ghi]
#

#--- code -----------------------------------------------------------
$sample = 1     # end-of-line comment
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"sample",
		{
			"line": 1,
			"value": 1
		},
		{
			"line": 1
		}
	],
	{
		"comment": "end-of-line comment",
		"line": 1
	}
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["sample", [{"primitive": 1}]]
	}
]
#--------------------------------------------------------------------

#
# name: assignment with end-of-line comment
#====================================================================


#====================================================================
# name: assignment [ghi]
#

#--- code -----------------------------------------------------------
$x = 1
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"line": 1,
			"value": 1
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------


#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"primitive": 1}]]
	}
]
#--------------------------------------------------------------------

#
# name: assignment
#====================================================================


#====================================================================
# name: multi-statement line with semicolons [ghi]
#

#--- code -----------------------------------------------------------
$a = 1; $b = 2; $c = 3          # semicolons as command separators
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"a",
		{
			"line": 1,
			"value": 1
		},
		{
			"line": 1
		}
	],
	[
		"scope",
		"setvar",
		"b",
		{
			"line": 1,
			"value": 2
		},
		{
			"line": 1
		}
	],
	[
		"scope",
		"setvar",
		"c",
		{
			"line": 1,
			"value": 3
		},
		{
			"line": 1
		}
	],
	{
		"comment": "semicolons as command separators",
		"line": 1
	}
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["a", [{"primitive": 1}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["b", [{"primitive": 2}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["c", [{"primitive": 3}]]
	}
]
#--------------------------------------------------------------------

#
# name: multi-statement line with semicolons
#====================================================================


#====================================================================
# name: collapsed runs of semicolons [ghi]
#

#--- code -----------------------------------------------------------
;;; $d = 4 ;;;                  # collapsed runs of semicolons
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"d",
		{
			"line": 1,
			"value": 4
		},
		{
			"line": 1
		}
	],
	{
		"comment": "collapsed runs of semicolons",
		"line": 1
	}
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["d", [{"primitive": 4}]]
	}
]
#--------------------------------------------------------------------

#
# name: collapsed runs of semicolons
#====================================================================


#====================================================================
# name: juxtaposed statements (no separators) [ghi]
#

#--- code -----------------------------------------------------------
$a = 1 $b = 2 $c = 3            # no semicolons
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"a",
		{
			"line": 1,
			"value": 1
		},
		{
			"line": 1
		}
	],
	[
		"scope",
		"setvar",
		"b",
		{
			"line": 1,
			"value": 2
		},
		{
			"line": 1
		}
	],
	[
		"scope",
		"setvar",
		"c",
		{
			"line": 1,
			"value": 3
		},
		{
			"line": 1
		}
	],
	{
		"comment": "no semicolons",
		"line": 1
	}
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["a", [{"primitive": 1}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["b", [{"primitive": 2}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["c", [{"primitive": 3}]]
	}
]
#--------------------------------------------------------------------

#
# name: juxtaposed statements (no separators)
#====================================================================


#====================================================================
# name: chained assignment [ghi]
#

#--- code -----------------------------------------------------------
$x = $y = $z = $j
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"z",
		{
			"var": "j"
		},
		{
			"line": 1
		}
	],
	[
		"scope",
		"setvar",
		"y",
		{
			"var": "z"
		},
		{
			"line": 1
		}
	],
	[
		"scope",
		"setvar",
		"x",
		{
			"var": "y"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["z", [{"var": "j"}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["y", [{"var": "z"}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"var": "y"}]]
	}
]
#--------------------------------------------------------------------

#
# name: chained assignment
#====================================================================


#====================================================================
# Sigils
#====================================================================


#====================================================================
# name: $ sigil in a setvar [ghi]
#

#--- code -----------------------------------------------------------
$local_var = 10
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"local_var",
		{
			"line": 1,
			"value": 10
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["local_var", [{"primitive": 10}]]
	}
]
#--------------------------------------------------------------------

#
# name: $ sigil in a setvar
#====================================================================


#====================================================================
# name: bare-word call, no args [ghi]
#

#--- code -----------------------------------------------------------
&bare_call
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": "bare_call",
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"var": "bare_call", "fn": "call"}]
#--------------------------------------------------------------------

#
# name: bare-word call, no args
#====================================================================


#====================================================================
# name: bare-word call with one arg [ghi]
#

#--- code -----------------------------------------------------------
&bare_call 10
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": "bare_call"
		},
		{
			"line": 1,
			"value": 10
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "bare_call",
		"fn": "call",
		"args": [[{"primitive": 10}]]
	}
]
#--------------------------------------------------------------------

#
# name: bare-word call with one arg
#====================================================================


#====================================================================
# name: bare-word call, empty parens [ghi]
#

#--- code -----------------------------------------------------------
&bare_call()
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": "bare_call",
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"var": "bare_call", "fn": "call"}]
#--------------------------------------------------------------------

#
# name: bare-word call, empty parens
#====================================================================


#====================================================================
# name: bare-word call, parenthesized arg [ghi]
#

#--- code -----------------------------------------------------------
&bare_call(10)
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": "bare_call"
		},
		{
			"line": 1,
			"value": 10
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "bare_call",
		"fn": "call",
		"args": [[{"primitive": 10}]]
	}
]
#--------------------------------------------------------------------

#
# name: bare-word call, parenthesized arg
#====================================================================


#====================================================================
# name: method call with dot notation [ghi]
#

#--- code -----------------------------------------------------------
$obj.field_access
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"left": {
				"line": 1,
				"var": "obj"
			},
			"line": 1,
			"op": ".",
			"right": "field_access"
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"var": "obj", "fn": "field_access"}]
#--------------------------------------------------------------------

#
# name: method call with dot notation
#====================================================================


#====================================================================
# name: bwc-then-dot chain as expression [ghi]
# `foo.bar` — `foo` is a bareword (a DSL may resolve it to a method at
# runtime); `.bar` chains on the returned value. Same shape as
# `$var.bar` or `@field.bar`, just with a `{bwc: "foo"}` receiver.
#

#--- code -----------------------------------------------------------
foo.bar
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"left": {
				"bwc": "foo",
				"line": 1
			},
			"line": 1,
			"op": ".",
			"right": "bar"
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"bwc": "foo", "fn": "bar"}]
#--------------------------------------------------------------------

#
# name: bwc-then-dot chain as expression
#====================================================================


#====================================================================
# name: bareword setter call — foo = 'bar' [ghi]
# `foo = 'bar'` is a BWC named `foo=` with one arg — the setter form
# of the BWC `foo`. In a DSL, this typically resolves at runtime to a
# method call on some caller object (something like `$obj.foo = 'bar'`),
# but the parser can't know that; it just records the BWC. Symmetric
# with `.name = X` becoming a `.name=` method call.
#

#--- code -----------------------------------------------------------
foo = 'bar'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"bwc": "foo=",
			"line": 1
		},
		{
			"line": 1,
			"value": "bar"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"bwc": "foo=",
		"args": [[{"primitive": "bar"}]]
	}
]
#--------------------------------------------------------------------

#
# name: bareword setter call — foo = 'bar'
#====================================================================


#====================================================================
# name: amp-call with dot chain target — bareword receiver [ghi]
# `&foo.bar` — amp binds tighter than dot. `&foo` is sugar for
# `$foo.call`, so the whole expression is `$foo.call.bar`: read the
# variable `foo`, invoke `.call` on it, then chain `.bar` on the
# returned value. The `syn: true` on step 1 records the `&` sugar;
# step 2's `.bar` is written literally so no syn marker.
#

#--- code -----------------------------------------------------------
&foo.bar
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": {
				"left": {
					"bwc": "foo",
					"line": 1
				},
				"line": 1,
				"op": ".",
				"right": "bar"
			},
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"var": "foo", "fn": "call"}, {"rv": true, "fn": "bar"}]
#--------------------------------------------------------------------

#
# name: amp-call with dot chain target — bareword receiver
#====================================================================


#====================================================================
# name: amp-call with dot chain target — @-field receiver [ghi]
# `&@foo.bar` — amp binds tighter than dot. `@foo` desugars to
# `%bucket['foo']` and `&X` is sugar for `X.call`, so the whole
# expression is `%bucket['foo'].call.bar`: read `foo` from the
# bucket, invoke `.call` on the result, then chain `.bar`. Each
# desugaring step carries its own `syn: true`; the literal `.bar` does not.
#

#--- code -----------------------------------------------------------
&@foo.bar
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": {
				"left": {
					"at": "foo",
					"line": 1
				},
				"line": 1,
				"op": ".",
				"right": "bar"
			},
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"bucket": true,
		"fn": "[]",
		"syn": true,
		"args": [[{"primitive": "foo"}]]
	},
	{"rv": true, "fn": "call"},
	{"rv": true, "fn": "bar"}
]
#--------------------------------------------------------------------

#
# name: amp-call with dot chain target — @-field receiver
#====================================================================


#====================================================================
# name: amp-call with dot chain target — $var receiver [ghi]
# `&$var.method` — same rule with an explicit-variable receiver:
# `&$var` is sugar for `$var.call`, so the whole expression is
# `$var.call.method`. Read `var`, invoke `.call`, then chain `.method`.
#

#--- code -----------------------------------------------------------
&$var.method
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": {
				"left": {
					"line": 1,
					"var": "var"
				},
				"line": 1,
				"op": ".",
				"right": "method"
			},
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"var": "var", "fn": "call"}, {"rv": true, "fn": "method"}]
#--------------------------------------------------------------------

#
# name: amp-call with dot chain target — $var receiver
#====================================================================


#====================================================================
# name: dot RHS is amp-call, paren-less outer args [ghi]
# `$foo.&bar('a', 'b') 1, 2, 3` — the `.RHS` is an amp-call
# `&bar('a', 'b')` whose returned value becomes the method name; the
# trailing `1, 2, 3` are the outer method call's positional args.
#

#--- code -----------------------------------------------------------
$foo.&bar('a', 'b') 1, 2, 3
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"args": [
				{
					"line": 1,
					"value": 1
				},
				{
					"line": 1,
					"value": 2
				},
				{
					"line": 1,
					"value": 3
				}
			],
			"left": {
				"line": 1,
				"var": "foo"
			},
			"line": 1,
			"op": ".",
			"right": [
				{
					"amp": "bar",
					"line": 1
				},
				{
					"line": 1,
					"value": "a"
				},
				{
					"line": 1,
					"value": "b"
				}
			]
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "bar",
		"fn": "call",
		"args": [[{"primitive": "a"}], [{"primitive": "b"}]]
	},
	{
		"var": "foo",
		"fn": {"rv": true},
		"args": [[{"primitive": 1}], [{"primitive": 2}], [{"primitive": 3}]]
	}
]
#--------------------------------------------------------------------

#
# name: dot RHS is amp-call, paren-less outer args
#====================================================================


#====================================================================
# name: dot RHS is amp-call, parenthesized outer args [ghi]
# `$foo.&bar('a', 'b')(1, 2, 3)` — same semantics as the paren-less
# form; CaspJ and CaspM are identical for both.
#

#--- code -----------------------------------------------------------
$foo.&bar('a', 'b')(1, 2, 3)
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"args": [
				{
					"line": 1,
					"value": 1
				},
				{
					"line": 1,
					"value": 2
				},
				{
					"line": 1,
					"value": 3
				}
			],
			"left": {
				"line": 1,
				"var": "foo"
			},
			"line": 1,
			"op": ".",
			"right": [
				{
					"amp": "bar",
					"line": 1
				},
				{
					"line": 1,
					"value": "a"
				},
				{
					"line": 1,
					"value": "b"
				}
			]
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "bar",
		"fn": "call",
		"args": [[{"primitive": "a"}], [{"primitive": "b"}]]
	},
	{
		"var": "foo",
		"fn": {"rv": true},
		"args": [[{"primitive": 1}], [{"primitive": 2}], [{"primitive": 3}]]
	}
]
#--------------------------------------------------------------------

#
# name: dot RHS is amp-call, parenthesized outer args
#====================================================================


#====================================================================
# name: dot RHS is parenthesized expression [ghi]
# `$foo.(&bar || 'gup') 1, 2, 3` — the parenthesized expression on
# the RHS of the dot evaluates to a method name (either `&bar`'s
# return or the string `'gup'`); the outer method call is invoked
# on `$foo` with args `1, 2, 3`.
#

#--- code -----------------------------------------------------------
$foo.(&bar || 'gup') 1, 2, 3
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"args": [
				{
					"line": 1,
					"value": 1
				},
				{
					"line": 1,
					"value": 2
				},
				{
					"line": 1,
					"value": 3
				}
			],
			"left": {
				"line": 1,
				"var": "foo"
			},
			"line": 1,
			"op": ".",
			"right": {
				"left": [
					{
						"amp": "bar",
						"line": 1
					}
				],
				"op": "||",
				"right": {
					"line": 1,
					"value": "gup"
				}
			}
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{"var": "bar", "fn": "call"},
	{
		"rv": true,
		"fn": "or",
		"syn": true,
		"args": [[{"primitive": "gup"}]]
	},
	{
		"var": "foo",
		"fn": {"rv": true},
		"args": [[{"primitive": 1}], [{"primitive": 2}], [{"primitive": 3}]]
	}
]
#--------------------------------------------------------------------

#
# name: dot RHS is parenthesized expression
#====================================================================


#====================================================================
# name: method call with single-quoted string method name [ghi]
# `$foo.'bar'` is the string-literal form of the bareword `$foo.bar`.
# CaspJ preserves the syntactic difference (`right` is a `{v: "bar"}`
# value atom, not the bare string `"bar"`); CaspM erases it (both
# collapse to `fn: "bar"`).
#

#--- code -----------------------------------------------------------
$foo.'bar'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"left": {
				"line": 1,
				"var": "foo"
			},
			"line": 1,
			"op": ".",
			"right": {
				"line": 1,
				"v": "bar"
			}
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"var": "foo", "fn": "bar"}]
#--------------------------------------------------------------------

#
# name: method call with single-quoted string method name
#====================================================================


#====================================================================
# name: method call with double-quoted string method name [ghi]
# `$foo."bar"` — same as `$foo.'bar'`; the quote style is cosmetic
# and drops out at norm.
#

#--- code -----------------------------------------------------------
$foo."bar"
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"left": {
				"line": 1,
				"var": "foo"
			},
			"line": 1,
			"op": ".",
			"right": {
				"line": 1,
				"v": "bar"
			}
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[{"var": "foo", "fn": "bar"}]
#--------------------------------------------------------------------

#
# name: method call with double-quoted string method name
#====================================================================


#====================================================================
# Literals — numbers
#====================================================================


#====================================================================
# name: whole number literal [ghi]
#

#--- code -----------------------------------------------------------
$whole = 42
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"whole",
		{
			"line": 1,
			"value": 42
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["whole", [{"primitive": 42}]]
	}
]
#--------------------------------------------------------------------

#
# name: whole number literal
#====================================================================


#====================================================================
# name: underscore-separated number literal [ghi]
#

#--- code -----------------------------------------------------------
$sep = 1_000_000
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"sep",
		{
			"line": 1,
			"value": 1000000
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
