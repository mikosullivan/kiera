#====================================================================
# name: multi-key subscript get [ghi]
# string, integer, and variable keys
#

#--- code -----------------------------------------------------------
$foo['bar', 2, $gup]
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"var": "foo"
		},
		"[]",
		{
			"args": [
				{
					"line": 1,
					"value": "bar"
				},
				{
					"line": 1,
					"value": 2
				},
				{
					"line": 1,
					"var": "gup"
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "foo",
		"fn": "[]",
		"args": [[{"primitive": "bar"}], [{"primitive": 2}], [{"var": "gup"}]]
	}
]
