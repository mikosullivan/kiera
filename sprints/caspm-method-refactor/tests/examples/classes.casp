#!/usr/bin/caspian

vibecode <<EOF
{
	"doc":    "test_cases_parsing_classes",
	"role":   "sibling of parse.casp holding transpiler fixtures whose primary subject is class-related constructs: class definitions (bare, with body, with methods), amend (bare-target and parenthesized-target), instance construction (bare, with args, with body), singleton methods attached to specific objects. Split out to keep parse.casp focused on other syntactic surfaces; same fixture format (boxed by `#===...` outer borders, sections `#--- code ---` / `#--- CaspJ ---` / `#--- CaspM ---` or `#--- CaspM refactor ---`), read by the same parse-extract module.",
	"status": "growing; the top-level `method &name(...) end` fixtures currently in parse.casp's Functions section could migrate here if the class-related organizing principle wins over the callable-definition principle"
}
EOF

