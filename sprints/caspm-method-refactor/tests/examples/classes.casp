#
# name: array push (paren-less method call)
#====================================================================


# design decisions made unilaterally for Section 21:
#
#   - array element get / set share the "[]" and "[]=" method-name shapes
#     with hash (Section 20). the runtime dispatches on receiver type;
#     the shape is uniform.
#   - negative integer indices parse via the existing parse_number path
#     ({value: -1}). the runtime's array-wrap semantics are its concern.
#   - `$array[-0]` — `-0` is preserved as `{value: 0, neg_zero: true}` so
#     the runtime's last-element dispatch can distinguish it from `{value: 0}`.
#     Fixture directly above; Section 3's "negative zero" test covers the
#     literal-form side.

#====================================================================
# Bare word commands
#====================================================================


# design decision needed from Miko before this section can land tests:
#
#   what does an undecorated identifier at statement position mean?
#     - foo 'bar'      — a bare-word command (like &foo 'bar' without the &)? no
#     - foo('bar')     — same, with parens? yes
#     - $j = foo + bar — foo and bar as variable references without $?
#
# option (a): reserve bare identifiers for bare-word commands. that conflicts
# with the current $-sigil discipline everywhere else. option (b): reserve
# them for local variables (a la Ruby / Python). option (c): keep the current
# spec (undecorated identifier at statement start is a syntax error) and
# force the & or $ sigil for disambiguation. Miko decides.

# Response: bare word commands are not like regular "&" commands.
# See the docs on DSL for what they are. They should be preserved
# in Caspj as bare word commands.
#
# Statement position: `foo 'bar'` and `foo('bar')` both produce the
# bwc-call shape `[{bwc: "foo"}, {value: "bar"}]` (same as with kwargs
# in Section 12). Expression position: a bare identifier transpiles to
# a `{bwc: name}` atom — same atom the statement form emits, just used
# as a value.

#====================================================================
# name: bareword-command call at statement position (paren-less form) [ghi]
#

#--- code -----------------------------------------------------------
foo 'bar'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"bwc": "foo"
		},
		{
			"line": 1,
			"value": "bar"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"bwc": "foo",
		"args": [[{"primitive": "bar"}]]
	}
]
#--------------------------------------------------------------------

#
# name: bareword-command call at statement position (paren-less form)
#====================================================================


#====================================================================
# name: bareword-command call at statement position (parens form) [ghi]
#

#--- code -----------------------------------------------------------
foo('bar')
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"bwc": "foo"
		},
		{
			"line": 1,
			"value": "bar"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"bwc": "foo",
		"args": [[{"primitive": "bar"}]]
	}
]
#--------------------------------------------------------------------

#
# name: bareword-command call at statement position (parens form)
#====================================================================


#====================================================================
# name: bare identifier at expression position [ghi]
# `{bwc: name}` atom
#

#--- code -----------------------------------------------------------
$j = foo + bar
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"j",
		{
			"left": {
				"bwc": "foo",
				"line": 1
			},
			"line": 1,
			"op": "+",
			"right": {
				"bwc": "bar",
				"line": 1
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": [
			"j",
			[
				{
					"bwc": "foo",
					"fn": "+",
					"syn": true,
					"args": [[{"bwc": "bar"}]]
				}
			]
		]
	}
]
#--------------------------------------------------------------------

