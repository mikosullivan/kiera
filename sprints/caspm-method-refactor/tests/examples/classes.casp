#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"html",
		{
			"left": [
				{
					"amp": "normalize",
					"line": 1
				},
				{
					"line": 1,
					"var": "text"
				}
			],
			"op": "|",
			"right": {
				"left": {
					"var": "formatter"
				},
				"op": ".",
				"right": "render"
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		{
			"cmd": "="
		},
		"html",
		[
			{
				"cmd": "mc"
			},
			{
				"a": [
					[
						{
							"cmd": "mc"
						},
						{
							"a": [
								{
									"var": "text"
								}
							],
							"fn": "call",
							"rcvr": {
								"var": "normalize"
							}
						}
					]
				],
				"fn": "render",
				"rcvr": {
					"var": "formatter"
				}
			}
		]
	]
]
