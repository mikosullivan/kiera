#====================================================================
# name: documentation with interpolating-terminator heredoc [ghi]
# `<<"EOF"` gets the `dq: true` flag as usual; the runtime rule is that documentation ignores it (never interpolates), but the transpiler still emits the flag as source-fidelity
#

#--- code -----------------------------------------------------------
documentation <<"EOF"
literal #{do_not_interpolate}
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"bwc": "documentation"
		},
		{
			"dq": true,
			"value": "literal #{do_not_interpolate}"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"bwc": "documentation",
		"args": [[{"primitive": "literal #{do_not_interpolate}"}]]
	}
]
