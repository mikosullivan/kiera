#
# name: generalized `&(EXPR)` as pipe RHS
#====================================================================


# three equivalent forms all normalize to the same method-call shape
#====================================================================
# name: `&<obj>` normalizes to the object's `.call` method [ghi]
# `&` before any object means "invoke the object's `.call` method" — always,
# no runtime property lookup. Full CaspJ preserves the three surface forms
# distinctly ({var}/method-call for `$foo.call(...)`, `{amp: "foo"}` for
# `&foo`, and `{amp: {var: "foo"}}` for the `&$foo` shorthand). Norm collapses
# all three to a method_call with `fn: "call"` — the runtime sees one shape.
#

#--- code -----------------------------------------------------------
$foo.call('xyz')
&foo 'xyz'
&$foo 'xyz'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"args": [
				{
					"line": 1,
					"value": "xyz"
				}
			],
			"left": {
				"var": "foo"
			},
			"line": 1,
			"op": ".",
			"right": "call"
		}
	],
	[
		{
			"amp": "foo"
		},
		{
			"line": 2,
			"value": "xyz"
		},
		{
			"line": 2
		}
	],
	[
		{
			"amp": {
				"line": 3,
				"var": "foo"
			}
		},
		{
			"line": 3,
			"value": "xyz"
		},
		{
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		[
			{
				"cmd": "mc"
			},
			{
				"a": [
					{
						"v": "xyz"
					}
				],
				"fn": "call",
				"rcvr": {
					"var": "foo"
				}
			}
		]
	],
	[
		{
			"cmd": "mc"
		},
		{
			"a": [
				{
					"v": "xyz"
				}
			],
			"fn": "call",
			"rcvr": {
				"var": "foo"
			}
		}
	],
	[
		{
			"cmd": "mc"
		},
		{
			"a": [
				{
					"v": "xyz"
				}
			],
			"fn": "call",
			"rcvr": {
				"var": "foo"
			}
		}
	]
]
#--------------------------------------------------------------------

