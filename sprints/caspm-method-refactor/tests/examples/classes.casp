#
# name: pipe receiver form on the RHS
#====================================================================


#====================================================================
# name: pipe chain of `$obj.method` stages [ghi]
# each stage prepends the LHS as the first positional arg of the RHS
# call. `$foo.bar | $gup.zap | $bear.blah` runs as
# `$bear.blah($gup.zap($foo.bar))`.
#

#--- code -----------------------------------------------------------
$foo.bar | $gup.zap | $bear.blah
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"left": {
				"left": {
					"left": {
						"line": 1,
						"var": "foo"
					},
					"line": 1,
					"op": ".",
					"right": "bar"
				},
				"op": "|",
				"right": {
					"left": {
						"var": "gup"
					},
					"op": ".",
					"right": "zap"
				}
			},
			"line": 1,
			"op": "|",
			"right": {
				"left": {
					"var": "bear"
				},
				"op": ".",
				"right": "blah"
			}
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{"var": "foo", "fn": "bar"},
	{
		"rv": true,
		"fn": "|",
		"args": [[{"var": "gup", "fn": "zap"}]]
	},
	{
		"rv": true,
		"fn": "|",
		"args": [[{"var": "bear", "fn": "blah"}]]
	}
]
#--------------------------------------------------------------------

#
# name: pipe chain of `$obj.method` stages
#====================================================================


# sticky null-propagation with |&, wrapped over multiple lines

#====================================================================
# name: multi-line pipe with trailing `|&` [ghi]
# `|&` is the null-safe pipe (distinct from `|`); trailing `|` or `|&` at line end continues the statement
#

#--- code -----------------------------------------------------------
$saved = &get_record 42 |&
	&validate |
	&transform |
	&save
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"saved",
		{
			"left": {
				"left": {
					"left": [
						{
							"amp": "get_record",
							"line": 1
						},
						{
							"line": 1,
							"value": 42
						}
					],
					"op": "|&",
					"right": [
						{
							"amp": "validate"
						}
					]
				},
				"op": "|",
				"right": [
					{
						"amp": "transform"
					}
				]
			},
			"op": "|",
			"right": [
				{
					"amp": "save"
				}
			]
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		{
			"cmd": "="
		},
		"saved",
		[
			{
				"cmd": "mc"
			},
			{
				"a": [
					[
						{
							"cmd": "mc"
						},
						{
							"a": [
								[
									{
										"cmd": "mc"
									},
									{
										"a": [
											[
												{
													"cmd": "mc"
												},
												{
													"a": [
														{
															"v": 42
														}
													],
													"fn": "call",
													"rcvr": {
														"var": "get_record"
													}
												}
											]
										],
										"fn": "call",
										"rcvr": {
											"var": "validate"
										}
									}
								]
							],
							"fn": "call",
							"rcvr": {
								"var": "transform"
							}
						}
					]
				],
				"fn": "call",
				"rcvr": {
					"var": "save"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

#
# name: multi-line pipe with trailing `|&`
#====================================================================

#====================================================================
# documentation and vibecode heredocs
#====================================================================

# documentation and vibecode are ordinary sys-methods invoked as calls.
# The heredoc form is the common one — the block body becomes the single
# arg. Runtime rule: neither method interpolates its arg even when the
# terminator is quoted (`<<"EOF"`). The transpiler doesn't enforce that
# — it emits the same `[{sys: NAME}, {value: text, dq?}]` shape as any
# other sys-call with a heredoc arg; the "no interpolation" rule is
# runtime-side.


#====================================================================
# name: documentation with plain heredoc [ghi]
# `documentation <<EOF ... EOF` — sys-method call with heredoc body as arg
#

#--- code -----------------------------------------------------------
$foo = 1

documentation <<EOF
plain doc text
across two lines
EOF

$foo = 2
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"foo",
		{
			"line": 1,
			"value": 1
		},
		{
			"line": 1
		}
	],
	[
		{
			"bwc": "documentation"
		},
		{
			"value": "plain doc text\nacross two lines"
		},
		{
			"line": 3
		}
	],
	[
		"scope",
		"setvar",
		"foo",
		{
			"line": 5,
			"value": 2
		},
		{
			"line": 5
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["foo", [{"primitive": 1}]]
	},
	{
		"bwc": "documentation",
		"args": [[{"primitive": "plain doc text\nacross two lines"}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["foo", [{"primitive": 2}]]
	}
]
#--------------------------------------------------------------------

#
# name: documentation with plain heredoc
#====================================================================


#====================================================================
# name: vibecode with plain heredoc [ghi]
# `vibecode <<EOF ... EOF` — same sys-call shape as documentation
#

#--- code -----------------------------------------------------------
vibecode <<EOF
{"role": "example"}
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"bwc": "vibecode"
		},
		{
			"value": "{\"role\": \"example\"}"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"bwc": "vibecode",
		"args": [[{"primitive": "{\"role\": \"example\"}"}]]
	}
]
#--------------------------------------------------------------------

#
# name: vibecode with plain heredoc
