#
# name: composite
# a whole class body integrating inherits, abstract, fields (:sym + 'string' name), init with @-auto-assign, methods (plain / private / autorun+private / pipe-modified / long-form / bareword-BWC / method with subscript-set and sys-method call), inline-label comment, and a %bucket setter
#====================================================================


# instantiation
#====================================================================
# name: .new() with quoted-string kwarg keys [ghi]
# `'name': 'x'` and `"rank": 'y'` produce the same {kw} shape as bareword keys
#

#--- code -----------------------------------------------------------
$captain = $character.new('name': 'picard', "rank": 'captain')
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"captain",
		[
			{
				"line": 1,
				"var": "character"
			},
			"new",
			{
				"args": [],
				"kw": [
					[
						"name",
						{
							"line": 1,
							"value": "picard"
						}
					],
					[
						"rank",
						{
							"line": 1,
							"value": "captain"
						}
					]
				],
				"line": 1
			}
		],
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		{
			"cmd": "="
		},
		"captain",
		[
			{
				"cmd": "mc"
			},
			{
				"fn": "new",
				"kw": [
					[
						"name",
						{
							"v": "picard"
						}
					],
					[
						"rank",
						{
							"v": "captain"
						}
					]
				],
				"rcvr": {
					"var": "character"
				}
			}
		]
	]
]
#--------------------------------------------------------------------

