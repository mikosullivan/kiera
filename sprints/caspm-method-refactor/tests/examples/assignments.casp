#====================================================================
# name: attribute assignment [ghi]
#

#--- code -----------------------------------------------------------
$obj.name = 'alice'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"args": [
				{
					"line": 1,
					"value": "alice"
				}
			],
			"left": {
				"line": 1,
				"var": "obj"
			},
			"line": 1,
			"op": ".",
			"right": "name="
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "obj",
		"fn": "name=",
		"args": [[{"primitive": "alice"}]]
	}
]
#--------------------------------------------------------------------

#
# name: attribute assignment
#====================================================================


# Prefix `++$foo` / `--$foo` are DELIBERATELY NOT in V1 — postfix only.
# The postfix forms below have promoted fixtures earlier in this section.
# $foo++      (postfix — implemented)
# $foo--      (postfix — implemented)
# ++$foo      (prefix — not V1)
# --$foo      (prefix — not V1)


# design decisions made unilaterally for Section 6:
#
#   - compound ops share a dedicated verb: ["scope", "setvar_op", OP, NAME, VALUE]
#     alternative was desugar to a binop RHS on plain setvar, deferred until Section 7
#     lands operator shapes. dedicated verb is cheaper and doesn't couple the two.
#
#   - index assignment adopts the archived method-call shape:
#     [{var: "hash"}, "[]=", {args: [key_expr, value_expr]}]. same shape for arrays.
#     runtime dispatches "[]=" like any other method on the receiver.
#
#   - attribute assignment likewise reads as a "attr=" method call:
#     [{var: "obj"}, "name=", {args: [value_expr]}]. matches Ruby-style setters.
#
# survey material below (juxtaposed assignment is already covered by Section 1's
# "juxtaposed statements" test; kept here as a reader hint for this section):
#====================================================================
# name: juxtaposed statements: $x = 2 $y = 3 [ghi]
#

#--- code -----------------------------------------------------------
$x = 2 $y = 3
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"line": 1,
			"value": 2
		},
		{
			"line": 1
		}
	],
	[
		"scope",
		"setvar",
		"y",
		{
			"line": 1,
			"value": 3
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"primitive": 2}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["y", [{"primitive": 3}]]
	}
]
#--------------------------------------------------------------------

#
# name: juxtaposed statements: $x = 2 $y = 3
#====================================================================


#====================================================================
# name: postfix increment statement [ghi]
# `$foo++` — sugar for `$foo += 1`, yields new value; wrapped as value-atom-row at statement position
#

#--- code -----------------------------------------------------------
$foo++
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"line": 1,
			"postinc": "foo"
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "foo",
		"fn": "+",
		"syn": true,
		"args": [[{"primitive": 1}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["foo", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: postfix increment statement
#====================================================================


#====================================================================
# name: postfix decrement statement [ghi]
# `$foo--` — sugar for `$foo -= 1`; value-atom-row at statement position
#

#--- code -----------------------------------------------------------
$foo--
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"line": 1,
			"postdec": "foo"
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"var": "foo",
		"fn": "-",
		"syn": true,
		"args": [[{"primitive": 1}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["foo", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: postfix decrement statement
#====================================================================


#====================================================================
# name: chained plain assignment as expression [ghi]
# `$x = $foo = 42` — assignment yields the assigned value; right-associative
#

#--- code -----------------------------------------------------------
$x = $foo = 42
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"line": 1,
			"setvar": {
				"name": "foo",
				"value": {
					"line": 1,
					"value": 42
				}
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["foo", [{"primitive": 42}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: chained plain assignment as expression
#====================================================================


#====================================================================
# name: three-deep chained assignment [ghi]
# `$x = $foo = $bar = 1` — right-associative nesting
#

#--- code -----------------------------------------------------------
$x = $foo = $bar = 1
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"line": 1,
			"setvar": {
				"name": "foo",
				"value": {
					"line": 1,
					"setvar": {
						"name": "bar",
						"value": {
							"line": 1,
							"value": 1
						}
					}
				}
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["bar", [{"primitive": 1}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["foo", [{"rv": true}]]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: three-deep chained assignment
#====================================================================


#====================================================================
# name: compound assignment as expression [ghi]
# `$x = ($foo += 1)` — parenthesized compound-assign at expression position
#

#--- code -----------------------------------------------------------
$x = ($foo += 1)
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"line": 1,
			"setvar_op": {
				"name": "foo",
				"op": "+",
				"value": {
					"line": 1,
					"value": 1
				}
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": [
			"foo",
			[
				{
					"var": "foo",
					"fn": "+",
					"syn": true,
					"args": [[{"primitive": 1}]]
				}
			]
		]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: compound assignment as expression
#====================================================================


#====================================================================
# name: postfix increment as expression RHS [ghi]
# `$x = $foo++` — yields the NEW value of $foo (not the old, unlike C-style postfix)
#

#--- code -----------------------------------------------------------
$x = $foo++
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"x",
		{
			"line": 1,
			"postinc": "foo"
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": [
			"foo",
			[
				{
					"var": "foo",
					"fn": "+",
					"syn": true,
					"args": [[{"primitive": 1}]]
				}
			]
		]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["x", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: postfix increment as expression RHS
#====================================================================


#====================================================================
# name: assignment inside a call argument [ghi]
# `&fn($status = 'ok')` — passes 'ok' to &fn AND sets $status; assignment-as-expression composes with any value-slot
#

#--- code -----------------------------------------------------------
&fn($status = 'ok')
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"amp": "fn"
		},
		{
			"line": 1,
			"setvar": {
				"name": "status",
				"value": {
					"line": 1,
					"value": "ok"
				}
			}
		},
		{
			"line": 1
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["status", [{"primitive": "ok"}]]
	},
	{
		"var": "fn",
		"fn": "call",
		"args": [[{"rv": true}]]
	}
]
#--------------------------------------------------------------------

#
# name: assignment inside a call argument
#====================================================================
