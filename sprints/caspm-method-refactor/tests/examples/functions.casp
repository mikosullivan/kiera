	{
		"frame": true,
		"fn": "closure",
		"name": "make_prefixer",
		"params": {"name": {}},
		"body": [
			{
				"bwc": "return",
				"args": [
					[
						{"var": "prefix", "fn": "+", "syn": true, "args": [[{"var": "name"}]]}
					]
				]
			}
		]
	},
	{
		"frame": true,
