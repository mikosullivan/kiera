		"frame": true,
		"fn": "function",
		"name": "add",
		"params": {"a": {}, "b": {}},
		"body": [
			{
				"bwc": "return",
				"args": [
					[
						{"var": "a", "fn": "+", "syn": true, "args": [[{"var": "b"}]]}
					]
				]
			}
		]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["add", [{"rv": true}]]
	}
]
