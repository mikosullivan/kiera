#!/usr/bin/caspian

vibecode <<EOF
{
	"doc":    "test_cases_parsing_functions",
	"role":   "sibling of parse.casp holding transpiler fixtures for function / closure / method definitions and their parameter shapes (bare, rich-metadata, splat, kwsplat, @-sigil params, sugar `function &name` vs long-form `$name = function(...)`, etc.). Split out from parse.casp's `# Functions and closures` section wholesale — includes a handful of @-sigil / setat fixtures that had been clustered there but are technically about the @ sigil rather than functions; those can migrate to a dedicated at-sigil file later if the organizing principle calls for it. Same fixture format (boxed by `#===...` outer borders, sections `#--- code ---` / `#--- CaspJ ---` / `#--- CaspM ---` or `#--- CaspM refactor ---`), read by the same parse-extract module.",
	"status": "growing; the @-sigil fixtures near the top of this file might migrate to a dedicated at-sigil file if that organizing cut proves useful"
}
EOF

#====================================================================
# Functions and closures
#====================================================================


#====================================================================
# name: function sugar form (function &name) [ghi]
#

#--- code -----------------------------------------------------------
function &welcome($name)
	return 'welcome, ' + $name
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"function": {
				"name": "welcome",
				"params": [
					"name"
				],
				"body": [
					[
						"scope",
						"return",
						{
							"left": {
								"line": 2,
								"value": "welcome, "
							},
							"line": 2,
							"op": "+",
							"right": {
								"line": 2,
								"var": "name"
							}
						},
						{
							"line": 2
						}
					]
				]
			},
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
[
	{
		"frame": true,
		"fn": "function",
		"name": "welcome",
		"params": {"name": {}},
		"body": [
			{
				"bwc": "return",
				"args": [
					[
						{"primitive": "welcome, ", "fn": "+", "syn": true, "args": [[{"var": "name"}]]}
					]
				]
			}
		]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["welcome", [{"rv": true}]]
	}
]
#--------------------------------------------------------------------

