	{
		"frame": true,
		"fn": "function",
		"name": "greet",
		"params": {},
		"body": [
			{"bwc": "return", "args": [[{"primitive": "hi"}]]}
		]
	},
	{
		"frame": true,
		"fn": "=",
		"syn": true,
		"args": ["greet", [{"rv": true}]]
	}
]
