		{
			"function": {
				"body": [
					[
						"scope",
						"return",
						{
							"left": {
								"line": 2,
								"var": "a"
							},
							"line": 2,
							"op": "+",
							"right": {
								"line": 2,
								"var": "b"
							}
						},
						{
							"line": 2
						}
					]
				],
				"name": "add",
				"params": [
