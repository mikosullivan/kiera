#====================================================================
# name: function sugar form with a lazy param (`&read`) [ghi]
# `&` in param position declares laziness. Callee-side param spec
# carries `lazy: true`; caller-side is unchanged from the "args are
# always step-lists" rule (see atom-keys). Full mechanism in the
# sprint's lazy-mechanism doc.
#

#--- code -----------------------------------------------------------
function &foo($idx, &read)
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"function": {
				"name": "foo",
				"params": [
					{
						"name": "idx"
					},
					{
						"name": "read",
						"lazy": true
					}
				],
				"body": []
			},
			"line": 2
		}
	]
]
#--------------------------------------------------------------------

