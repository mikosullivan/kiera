#

#--- code -----------------------------------------------------------
method to_string()
	return 'hi'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"line": 3,
			"method": {
				"body": [
					[
						"scope",
						"return",
						{
							"line": 2,
							"value": "hi"
						},
						{
							"line": 2
						}
					]
				],
				"name": "to_string",
				"params": []
			}
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		{
			"method": {
				"bd": [
					[
						"scope",
						"return",
						{
							"v": "hi"
						}
					]
				],
				"name": "to_string",
				"pm": []
			}
		}
	]
]
#--------------------------------------------------------------------

#
# name: method name without & sigil (bareword name
# & is optional for method)
#====================================================================


#====================================================================
# name: singleton method [ghi]
# receiver.name signature attaches method to a specific object
#

#--- code -----------------------------------------------------------
method $picard.log_entry()
	return 'stardate ' + %now.to_s
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"line": 3,
			"method": {
				"body": [
					[
						"scope",
						"return",
						{
							"left": {
								"line": 2,
								"value": "stardate "
							},
							"line": 2,
							"op": "+",
							"right": {
								"left": {
									"line": 2,
									"context": "now"
								},
								"line": 2,
								"op": ".",
								"right": "to_s"
							}
						},
						{
							"line": 2
						}
					]
				],
				"name": "log_entry",
				"params": [],
				"receiver": {
					"var": "picard"
				}
			}
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		{
			"method": {
				"bd": [
					[
						"scope",
						"return",
						[
							{
								"cmd": "mc"
							},
							{
								"a": [
									[
										{
											"cmd": "mc"
										},
										{
											"fn": "to_s",
											"rcvr": {
												"context": "now"
											}
										}
									]
								],
								"fn": "+",
								"rcvr": {
									"v": "stardate "
								}
							}
						]
					]
				],
				"name": "log_entry",
				"pm": [],
				"rcvr": {
					"var": "picard"
				}
			}
		}
	]
]
