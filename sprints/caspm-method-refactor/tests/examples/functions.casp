#====================================================================
# name: function with a rich-metadata param [ghi]
# `$name: {hash}` attaches constraints
#

#--- code -----------------------------------------------------------
function &fetch($url: {class: 'string'})
	&get $url
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		{
			"function": {
				"name": "fetch",
				"params": [
					{
						"meta": [
							[
								"class",
								{
									"value": "string"
								}
							]
						],
						"name": "url"
					}
				],
				"body": [
					[
						{
							"amp": "get"
						},
						{
							"line": 2,
							"var": "url"
						},
						{
							"line": 2
						}
					]
				]
			},
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM -----------------------------------------------------------
[
	[
		{
			"fn": {
				"bd": [
					[
						{
							"cmd": "mc"
						},
						{
							"a": [
								{
									"var": "url"
								}
							],
							"fn": "call",
							"rcvr": {
								"var": "get"
							}
						}
					]
				],
				"name": "fetch",
				"pm": [
					{
						"meta": [
							[
								"class",
								{
									"v": "string"
								}
							]
						],
						"name": "url"
					}
				]
			}
		}
	]
]
