#====================================================================
# name: composite [ghi]
# long-form assignment with every rich-param feature (metadata / splat / kwsplat)
#

#--- code -----------------------------------------------------------
$rich_params = function(
	$name,
	$rank: {optional: true, default: 'ensign'},
	$sent_title: {public: 'title'},
	&lazy_left,
	&lazy_right,
	*$args,
	**$opts,
	)
	return [$name, $rank, $sent_title, $rest, $opts]
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------
[
	[
		"scope",
		"setvar",
		"rich_params",
		{
			"function": {
				"params": [
					"name",
					{
						"meta": [
							[
								"optional",
								{
									"value": true
								}
							],
							[
								"default",
								{
									"value": "ensign"
								}
							]
						],
						"name": "rank"
					},
					{
						"meta": [
							[
								"public_name",
								{
									"value": "title"
								}
							]
						],
						"name": "sent_title"
					},
					{
						"meta": [
							[
								"lazy",
								{
