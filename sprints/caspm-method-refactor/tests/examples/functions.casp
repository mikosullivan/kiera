[
	[
		{
			"closure": {
				"body": [
					[
						"scope",
						"return",
						{
							"left": {
								"line": 2,
								"var": "prefix"
							},
							"line": 2,
							"op": "+",
							"right": {
								"line": 2,
								"var": "name"
							}
						},
						{
							"line": 2
						}
					]
				],
				"name": "make_prefixer",
				"params": [
					"name"
				]
			},
			"line": 3
		}
	]
]
#--------------------------------------------------------------------

#--- CaspM refactor --------------------------------------------------
