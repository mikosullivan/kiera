# name: return null (explicit null value
# distinct from bare return)
#====================================================================


#====================================================================
# name: return with a function call [ghi]
#

#--- Caspian -----------------------------------------------------------
return &compute
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: return with a function call
#====================================================================


#====================================================================
# name: %call.return with an argument [ghi]
# explicit method-call form preserved
#

#--- Caspian -----------------------------------------------------------
%call.return 'from this frame'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: %call.return with an argument
# explicit method-call form preserved
#====================================================================


#====================================================================
# name: %call.return with no arguments [ghi]
# bare method-call form preserved
#

#--- Caspian -----------------------------------------------------------
%call.return
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: %call.return with no arguments
# bare method-call form preserved
#====================================================================


# design decisions for Section 14 (return):
#
#   Two syntactic forms, DISTINCT CaspianJ:
#
#     return              -> ["scope", "return"]                    (2 elements)
#     return EXPR         -> ["scope", "return", EXPR]              (3 elements)
#     return null         -> ["scope", "return", {"value": null}]   (3 elements, explicit null)
#     %call.return        -> [{sys: "call"}, "return"]              (bare method call)
#     %call.return EXPR   -> [{sys: "call"}, "return", {args: [EXPR]}]  (method call w/ arg)
#
#   The `return` keyword is NOT rewritten to `%call.return` at parse time. If
#   the developer wrote the explicit method-call form, CaspJ preserves it.
#   Runtime treats both as "unwind the stack"; CaspJ just faithfully reflects
#   which form was written.
#
#   Bare `return` (no value slot) is distinct from `return null` — preserves
#   the "no value" case that Caspian's null-flavor discipline could otherwise
#   collapse.
#
# survey material below: the multi-line `function ... end` and `closure ... end`
# constructs that host return statements aren't tested yet (Section 11 deferred).

#====================================================================
# name: top-level function with early-exit return [ghi]
# multi-line `function &foo(...) ... end` at top-level scope
#

#--- Caspian -----------------------------------------------------------
function &early_exit($x)
	if $x < 0
		return null
	end

	return $x * 2
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: top-level function with early-exit return
#====================================================================

#====================================================================
# name: closure() with %call.return [ghi]
#

#--- Caspian -----------------------------------------------------------
$exit_frame = closure()
	%call.return 'from this frame'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: closure() with %call.return
#====================================================================


#====================================================================
# Function calls (survey)
#====================================================================


# language survey for bwc-with-args variations beyond Section 2's basics.
# Each of the survey lines below has a settled shape now — the Section 12
# kwargs/splat fixtures cover the shape family; this section stays a survey
# rather than duplicating those tests.
#
#   &foo                 — covered by Section 2
#   &foo()               — covered by Section 2
#   &foo 'bar'           — covered by Section 2
#   &foo gup: 'bar'      — kwarg paren-less: `[{amp:foo}, {kw:[[gup, {value:bar}]]}]`
#   &foo(gup: 'bar')     — kwarg parens form: same shape
#   &foo(gup: 'bar', 2)  — mixed → RAISES per "positional after keyword raises" rule

#====================================================================
# name: amp-call kwargs surface [ghi]
# bareword, empty parens, positional, kwarg-bareword, kwarg-parens
#

#--- Caspian -----------------------------------------------------------
&foo
&foo()
&foo 'bar'
&foo gup: 'bar'
&foo(gup: 'bar')
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: amp-call kwargs surface
# bareword, empty parens, positional, kwarg-bareword, kwarg-parens
#====================================================================


#====================================================================
# name: amp-call positional arg after keyword arg raises [ghi]
#

#--- Caspian -----------------------------------------------------------
&foo(gup: 'bar', 2)
#--------------------------------------------------------------------

#--- raises ---------------------------------------------------------
positional arg `2` after named args
#--------------------------------------------------------------------

#
# name: amp-call positional arg after keyword arg raises
#====================================================================


#====================================================================
# instance
#====================================================================


#====================================================================
# name: bare instance (no construction args) as setvar RHS [ghi]
#

#--- Caspian -----------------------------------------------------------
$greeter = instance
	method &hello($name)
		return 'Hello, ' + $name
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: bare instance (no construction args) as setvar RHS
#====================================================================


#====================================================================
# name: instance with construction args [ghi]
#

#--- Caspian -----------------------------------------------------------
$dsn = instance('localhost', 8080)
	method &init()
	end

	method &dsn()
		return 'tcp://' + @host + ':' + @port
	end

	autorun :dsn
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: instance with construction args
#====================================================================


#====================================================================
# name: instance with an inline comment right after the keyword [ghi]
#

#--- Caspian -----------------------------------------------------------
$config = instance # deploy config
	field :env, class: 'string', default: 'staging'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: instance with an inline comment right after the keyword
#====================================================================


# design decisions for Section 26 (instance):
#
#   `instance` is a block construct producing an instance value. Long-form
#   only (like class — no `instance &name` sugar).
#
#   Value-atom shape:
#     {instance: {body: [...]}}                       — bare (no construction args)
#     {instance: {args: [args...], body: [...]}}      — with construction args
#
#   `args` key is present only when the developer supplied `(args)` after the
#   keyword; omitted otherwise. Args are call-args (expressions), NOT param
#   declarations.
#
#   The `# comment` variant (`instance # deploy config`) is a plain Caspian
#   comment, not a name for the instance. Instances have no name-in-syntax;
#   they're bound to a variable via the enclosing setvar (`$foo = instance`).
#
#   Instance-body BWC calls (field, method, autorun, ...) reuse the same
#   shapes as class-body BWC calls (see Section 15).

#====================================================================
# name: instance body with method (multi-line) [ghi]
#

#--- Caspian -----------------------------------------------------------
$greeter = instance method hello($name)
		return 'Hello, ' + $name
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: instance body with method (multi-line)
#====================================================================


#====================================================================
# name: instance body with method (one line) [ghi]
#

#--- Caspian -----------------------------------------------------------
$greeter = instance method hello($name)return 'Hello, ' + $name end end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: instance body with method (one line)
#====================================================================


