# deferred: object dot amp-call, no args (`$obj.&getname` — receiver-dot
# followed by an amp-call segment). The consume_dot_segments path doesn't
# yet accept an amp-call on an object receiver; transpiler raises
# "cannot parse: $obj.&getname".
#
# Target source:
#     function &getname()
#         return 'match'
#     end
#     $obj.&getname


# deferred: object dot parenthesized expression (`$foo.(EXPR)` —
# receiver-dot followed by a parenthesized general expression as the
# dispatch target). Not yet parsed by consume_dot_segments; transpiler
# raises "cannot parse: $foo.(begin ...)".
#
# Target source:
#     $foo.(begin as $block
#         $block.return 'match'
#     end)


# deferred: amp-call receiver dot amp-call method with args
# (`&get_object.&get_func('big')(true)` — chained amp-calls with arg
# passing). The literal-parser hits the dot after an amp-call receiver
# and doesn't yet handle a follow-on amp-call segment; transpiler raises
# "cannot parse literal: .&get_func('big')(true)".
#
# Target source:
#     &get_object.&get_func('big')(true)


#====================================================================
# name: object dot keyword as method name [ghi]
# `$foo.if` — `if` is a keyword elsewhere, but in method position after
# a dot it's just a bareword method name (a string). Same shape as any
# other bareword method call; the parser treats whatever's after the
# dot as a method-name identifier, keyword-ness irrelevant.
#

#--- Caspian -----------------------------------------------------------
$foo.if
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: object dot keyword as method name
#====================================================================


# deferred: postfix bump on hash subscript (`$hsh['a']++`). Bumps work
# on subscript lvalues, not just plain variables — the parser needs to
# accept a subscript as an operand slot on the bump-op atom. `operand`
# accepts any lvalue expression the normalizer can resolve to a settable
# location; transpiler raises "cannot parse: $hsh['a']++".
#
# Target source:
#     $hsh = {a: 1}
#     $hsh['a']++


#====================================================================
# name: caller DSL setup and invoke [ghi]
# Exercises the caller-DSL pattern (functions/caller/dsl) end to end:
# a function containing a bare bwc (`foo`); a caller built from it; a
# .dsl call wiring the bwc to a receiver; and a .call invocation. The
# CaspM shows the bwc `foo` staying as {bwc: "foo"} in the function
# body (engine resolves at runtime via the active DSL), the assign bwc
# for the two setvar statements, and method_call bwcs for the three
# method calls (.new, .caller, .dsl, .call).
#

#--- Caspian -----------------------------------------------------------
$fn = function()
	foo
end

$caller = $fn.caller.new
$caller.dsl $bar, 'foo'
$caller.call
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: caller DSL setup and invoke
#====================================================================


#====================================================================
# name: binary method-op with variables — `$foo + $bar` [ghi]
# `+` is a method — CaspM collapses `{op:"+", left, right}` to a
# method_call with `receiver: $foo, function: "+", args: [$bar]`.
# Same rule for `-`, `*`, `/`, `%`, `**`, `==`, `!=`, `<`, `<=`, `>`,
# `>=`, `<=>`. Contrast with genuine non-method operators (`||`, `&&`,
# `|`, `|&`, `!`) which stay as op atoms.
#

#--- Caspian -----------------------------------------------------------
$x = $foo + $bar
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: binary method-op with variables — `$foo + $bar`
#====================================================================


#====================================================================
# name: paren-less dot method call with one arg — `$foo.zap $bar` [ghi]
# Paren-less method call at statement position — the row shape `[recv,
# method_name, {args: [...]}]` in CaspJ collapses to a method_call
# in CaspM (same envelope shape whether the source used parens or not).
#

#--- Caspian -----------------------------------------------------------
$foo.zap $bar
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: paren-less dot method call with one arg — `$foo.zap $bar`
#====================================================================


#====================================================================
# name: non-method binary operator — `$foo || $bar` [ghi]
# `||` is a genuine binary operator (short-circuit boolean OR), NOT a
# method — CaspM keeps the op atom shape unchanged. Same rule for
# `&&`, `|` (pipe), `|&` (null-safe pipe), `!` (unary not). The engine
# dispatches these on `op:` directly, no method-name lookup.
#

#--- Caspian -----------------------------------------------------------
$x = $foo || $bar
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: non-method binary operator — `$foo || $bar`
#====================================================================
