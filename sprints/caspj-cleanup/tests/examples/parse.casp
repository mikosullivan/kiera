# name: multiple do / do / dofunc blocks on one call [ghi]
#

#--- Caspian -----------------------------------------------------------
&run_scenarios do
	%call.return &scenario_a
end do
	%call.return &scenario_b
end dofunc
	%call.return &scenario_c
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: multiple do / do / dofunc blocks on one call
#====================================================================


#====================================================================
# name: do block with a single param [ghi]
#

#--- Caspian -----------------------------------------------------------
$items.each do ($item)
	&handle $item
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: do block with a single param
#====================================================================


#====================================================================
# name: bare yield (BWC [ghi]
# preserved, NOT desugared to %call.blocks[0].call)
#

#--- Caspian -----------------------------------------------------------
yield
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: bare yield (BWC
# preserved, NOT desugared to %call.blocks[0].call)
#====================================================================


#====================================================================
# name: yield with args (positional) [ghi]
#

#--- Caspian -----------------------------------------------------------
yield 1, true, 'foo'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: yield with args (positional)
#====================================================================


# design decisions for Section 13 (do/dofunc blocks, yield):
#
#   Blocks are NOT positional args — they're a separate array on the call.
#   Shape: appended to the call as a trailing `{blocks: [...]}` wrapper
#   (parallel to how kwargs use `{kw: [...]}`).
#
#   Block value atoms:
#     {do:     {params, body}}
#     {dofunc: {params, body}}
#   Same structural shape; different key preserves which form the developer
#   wrote (runtime knows the semantic difference — probably closure-like vs
#   function-like scope).
#
#   Block params: `do ($item)` and `do ($x, $y)` — same list-of-strings shape
#   as function/closure/method params. Empty list when no `(params)`.
#
#   Multi-block calls: each `end + do/dofunc` starts a new block on the SAME
#   call. All blocks land in the single `{blocks: [...]}` array in order.
#
#   `yield` is a BWC sugar for `%call.blocks[0].call`. CaspJ preserves the
#   `yield` form — does NOT rewrite to the desugared method-call shape.
#     yield              -> [{bwc: "yield"}]
#     yield 1, true, 'x' -> [{bwc: "yield"}, {value: 1}, {value: true}, {value: "x"}]

