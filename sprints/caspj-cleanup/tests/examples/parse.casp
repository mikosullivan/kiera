#--------------------------------------------------------------------

#
# name: punctuation-form logical not
#====================================================================


# design decisions made unilaterally for Section 7:
#
#   - binary op:   {op: "<op>", left: L, right: R}
#   - unary op:    {op: "not"|"!", operand: E}
#   - ternary:     {op: "?:", cond: C, "then": T, "else": F}
#
# all three share the top-level "op" key, so a runtime dispatcher can key off it
# without pattern-matching on shape. distinct from method-call shape
# ({var: X}, "method"], ...) because those are lists; operator expressions are dicts.
#
# known limitations, deferred:
#
#   - precedence and associativity for multi-op expressions. currently the parser
#     splits at the LEFTMOST top-level occurrence, which is right-associative for
#     the outer op. multi-op tests aren't in the fixture yet, so this hasn't been
#     forced into a decision.
#
#   - inline `and`/`or` require SURROUNDING SPACES to split. word ops without spaces
#     are treated as identifier characters. no test for word-op-without-space yet.


#====================================================================
# Bare blocks
#====================================================================


#====================================================================
# name: begin at statement position [ghi]
# `begin ... end` transpiles to a `{begin_end: {body, clauses}}` value-atom row; row value is discarded at statement position
#

#--- Caspian -----------------------------------------------------------
begin
	puts 'first'
	puts 'second'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: begin at statement position
#====================================================================


#====================================================================
# name: simple begin as expression on RHS of setvar [ghi]
#

#--- Caspian -----------------------------------------------------------
$x = begin
	$a = 10
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: simple begin as expression on RHS of setvar
#====================================================================


#====================================================================
# name: begin as expression on RHS of setvar [ghi]
# `$x = begin ... end` uses the block's value; last body expression is the value
#

#--- Caspian -----------------------------------------------------------
$x = begin
	$a = 10
	$b = 20
	$c = $a + $b
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: begin as expression on RHS of setvar
#====================================================================


#====================================================================
# name: begin with as $block controller [ghi]
# `$block.return VALUE` exits early; block value is the returned value
#

#--- Caspian -----------------------------------------------------------
$result = begin as $block
	$block.return 'whatever'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: begin with as $block controller
#====================================================================


#====================================================================
# name: begin with ensure clause [ghi]
# `ensure` runs on all exit paths — clause slot added on demand (not in the default 5-clause set) so an atom without a declared `ensure` doesn't carry an empty slot
#

#--- Caspian -----------------------------------------------------------
begin
	puts 'in body'
ensure
	puts 'always runs'
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: begin with ensure clause
#====================================================================


#====================================================================
# name: simple closure
#

closure($idx)
end

[
	{
		"frame": true,
		"fn": "closure",
		"params": {
			"idx": {}
		},

		"block": []
	}
]

