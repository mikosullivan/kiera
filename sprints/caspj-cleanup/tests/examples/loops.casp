# name: while loop with `as $loop` binding
#====================================================================


# break and break N
# deferred: `.each do` control-flow (break / next / clause markers) not yet parsed
# $people.each do ($person)
# 	if $person.suspicious?
# 		break
# 	end
# end

#====================================================================
# name: nested .each do with break 2 [ghi]
#

#--- Caspian -----------------------------------------------------------
$people.each do ($person) as $person_loop
	$person.addresses.each do ($address)
		if $address.matches($target)
			break 2
		end
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

