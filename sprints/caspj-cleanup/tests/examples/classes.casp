#
# name: plain heredoc (bare terminator, literal)
#====================================================================


#====================================================================
# name: typed heredoc [ghi]
# MIME-type annotation in parens
#

#--- Caspian -----------------------------------------------------------
$typed_heredoc = <<('text/markdown')EOF
# a heading
regular text
EOF
