#!/usr/bin/caspian

vibecode <<EOF
{
	"doc":    "test_cases_parsing_classes",
	"role":   "sibling of parse.casp holding transpiler fixtures whose primary subject is class-related constructs: class definitions (bare, with body, with methods), amend (bare-target and parenthesized-target), instance construction (bare, with args, with body), singleton methods attached to specific objects. Split out to keep parse.casp focused on other syntactic surfaces; same fixture format (boxed by `#===...` outer borders, sections `#--- code ---` / `#--- CaspJ ---` / `#--- CaspM ---` or `#--- CaspM refactor ---`), read by the same parse-extract module.",
	"status": "growing; the top-level `method &name(...) end` fixtures currently in parse.casp's Functions section could migrate here if the class-related organizing principle wins over the callable-definition principle"
}
EOF

#====================================================================
# Classes
#====================================================================


#====================================================================
# name: empty class as setvar RHS [ghi]
#

#--- Caspian -----------------------------------------------------------
$empty_cls = class
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: empty class as setvar RHS
#====================================================================

#====================================================================
# name: bare class with a single method (value discarded) [ghi]
# Anonymous class at statement position — no setvar wrapping, value discarded.
#

#--- Caspian -----------------------------------------------------------
class
	method &hello()
		return 'hi'
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: bare class with a single method (value discarded)
#====================================================================


#====================================================================
# name: class with a single method in its body [ghi]
#

#--- Caspian -----------------------------------------------------------
$widget = class
	method &hello()
		return 'hi'
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: class with a single method in its body
#====================================================================


#====================================================================
# name: class with a private method [ghi]
# `private` is a method on the class-being-worked-on, NOT a modifier
# keyword. Decomposes to two steps in the class body: register the
# method (rv = its pk), then dispatch .private on the class with that
# pk as arg. Same shape extends to protected / abstract / autorun /
# static / final / any DSL-defined access method.
#

#--- Caspian -----------------------------------------------------------
class
	private method &foo()
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: class with a private method
#====================================================================


#====================================================================
# name: class with @-auto-assign init [ghi]
# `method &init(@name, @rank) end` — the `@`-sigil on each param is
# sugar for "assign the arg value directly into `%bucket[name]` at
# param-binding time." Equivalent long form is
# `method &init($name, $rank) @name = $name; @rank = $rank end`;
# same net bucket state after init returns, just less boilerplate.
# Never fires setters — `@` is raw bucket access, same as everywhere
# else in the language (see syntax/sigils § @).
#
# CaspM refactor moves the auto-assign from a body-prepended setat
# sequence into per-param metadata: `{bucket: true}` on the spec.
# Body reflects only what the user actually wrote.
#

#--- Caspian -----------------------------------------------------------
class
	method &init(@name, @rank)
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: class with @-auto-assign init
#====================================================================


#====================================================================
# name: method sugar form (method &name) [ghi]
# only form available for methods
#

#--- Caspian -----------------------------------------------------------
method &init($name, $rank)
	return null
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: method sugar form (method &name)
# only form available for methods
#====================================================================


#====================================================================
# name: method with @-sigil param [ghi]
# auto-assign desugars to `["scope", "setat", name, {var: name}]` at body start
#

#--- Caspian -----------------------------------------------------------
method &init(@name, @rank)
end
