#
# name: typed heredoc
# MIME-type annotation in parens
#====================================================================


#====================================================================
# name: interpolating heredoc [ghi]
# <<"EOF" gets the same dq: true flag as a double-quoted string
#

#--- Caspian -----------------------------------------------------------
$interp_heredoc = <<"EOF"
hello, #{$sample}
tabs \t and newlines \n process here
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: interpolating heredoc
# <<"EOF" gets the same dq: true flag as a double-quoted string
#====================================================================


#====================================================================
# name: heredoc with an outdented body line [ghi]
# least-indented sets the base, only whitespace stripped
#

#--- Caspian -----------------------------------------------------------
	$literal_heredoc = <<'EOF'
	yeah
  this line is not as indented
	man
	EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: heredoc with an outdented body line
# least-indented sets the base, only whitespace stripped
#====================================================================


#====================================================================
# name: multiple heredocs threaded through one call [ghi]
# bodies match openers in order
#

#--- Caspian -----------------------------------------------------------
&pair_of_bodies($whole, <<A, $frac, <<B)
first heredoc body
A
second heredoc body
B
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: multiple heredocs threaded through one call
# bodies match openers in order
#====================================================================


#====================================================================
# name: heredoc with terminator string in the middle of a line (not a terminator) [ghi]
#

#--- Caspian -----------------------------------------------------------
$literal_heredoc = <<'EOF'
#{no interpolation} EOF
and no \n escape processing either
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: heredoc with terminator string in the middle of a line (not a terminator)
#====================================================================


#====================================================================
# name: multi-heredoc with mixed quoting [ghi]
# first is dq (interp), second is literal
#

#--- Caspian -----------------------------------------------------------
&foo 'x', <<"A", <<'B'
whatever
A
dude
B
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: multi-heredoc with mixed quoting
# first is dq (interp), second is literal
#====================================================================


#====================================================================
# name: multi-arg heredoc parens [ghi]
# kwargs flatten onto the atom next to content_type
#

#--- Caspian -----------------------------------------------------------
$literal_heredoc = <<('text/markdown', trim:true)'EOF'
#{no interpolation} EOF
and no \n escape processing either
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: multi-arg heredoc parens
# kwargs flatten onto the atom next to content_type
#====================================================================


#====================================================================
# name: heredoc parens with only a kwarg (no content_type positional) [ghi]
#

#--- Caspian -----------------------------------------------------------
$trimmed = <<(trim:true)EOF
raw body
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: heredoc parens with only a kwarg (no content_type positional)
#====================================================================


# design decisions for Section 19 (heredocs):
#
#   Every heredoc produces a plain string value-atom. Heredoc-ness is a
#   source-syntax convenience — the CaspianJ shape is the same {value: "..."}
#   that any string literal produces.
#
#   Heredoc paren block `<<(ARGS)EOF` parses like a regular function-call
#   arg list: at most one positional (bound to `content_type`, must be a
#   quoted string) plus any number of `key: value` kwargs (each value must
#   be a scalar literal). Kwargs flatten onto the atom next to content_type:
#     <<('text/markdown')EOF                -> {value: ..., content_type: "text/markdown"}
#     <<('text/markdown', trim:true)EOF     -> {value: ..., content_type: "text/markdown", trim: true}
#     <<(trim:true)EOF                      -> {value: ..., trim: true}
#   A bareword or non-string positional in the paren block raises.
#
#   Terminator quoting mirrors regular string quoting:
#     <<EOF       bare       - literal; no dq flag
#     <<'EOF'     single     - literal; no dq flag
#     <<"EOF"     double     - dq: true flag on the atom; runtime does interp + escape
#   Literal and bare forms produce identical atoms (byte-for-byte body from the
#   source after indent-stripping, no dq flag). The double-quoted form uses
#   the same `dq: true` shape as a `"..."` string literal — CaspJ preserves
#   the source content verbatim and the runtime handles `#{expr}` and escape
#   sequences.
#
#   Indent-stripping rule: the least-indented line (INCLUDING the terminator)
#   sets the base. That many leading whitespace chars are stripped from every
#   body line. Only whitespace is stripped — if a line's leading whitespace
#   is shorter than the base, stripping stops at the first non-whitespace.
#   Tabs and spaces both count as ONE char each (mixed usage produces a
#   compile-time warning per the spec — the warning system isn't implemented
#   yet, so the strip proceeds silently for now).
#
#   Terminator matches ONLY on a line whose sole content (after leading
#   whitespace) is the terminator identifier. A line with the terminator
#   name in the middle is body content — see the last test case.
#
#   Multi-heredoc statement: heredoc openers on a code line are collected
#   left-to-right; bodies are then consumed from the following lines in
#   opener-order (first opener gets the first body block, etc.).
#
#   Deferred (nice-to-have; no blocker):
#     - duplicate-terminator-name-per-statement raise
#     - mixed-tabs-and-spaces compile-time warning (needs the warning system)
#     - unclosed-heredoc-reaches-EOF raise wording lockdown

