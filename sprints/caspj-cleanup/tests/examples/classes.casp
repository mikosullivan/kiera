#====================================================================


# design decisions made unilaterally for Section 16:
#
#   - sys atom shape: {sys: "name"} — parallel to {var: "name"} and {bwc: "name"}
#   - sys-receiver method call: [{sys: "name"}, method, {args: [...]}] — same
#     shape as $-receiver method call, with the {sys: X} receiver in place of
#     {var: X}. runtime dispatches on receiver type.
#   - sys subscript: [{sys: "name"}, "[]", {args: [key_expr]}] — subscript is
#     a "[]" method call, matching the $-var and hash/array subscript shape.
#   - {sys: X}.attr with no parens uses the same "attr" method-name shape as
#     $recv.attr — no separate "field access" node. runtime distinguishes.
#

#====================================================================
# Pipes
#====================================================================


# The statement-leading pipe (`| bwc [args]`) rewrites the immediately-
# preceding statement by wrapping its value in a bwc call. Whitespace and
# newlines around the pipe are not significant — the three tests below
# produce identical CaspJ.

#====================================================================
# name: pipe on its own line after a multi-line method [ghi]
#

#--- Caspian -----------------------------------------------------------
method &foo()
end

| private
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: pipe on its own line after a multi-line method
#====================================================================


#====================================================================
# name: pipe on the same line as `end` after a multi-line method [ghi]
#

#--- Caspian -----------------------------------------------------------
method &foo()
end | private
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: pipe on the same line as `end` after a multi-line method
#====================================================================


# --- end sample

#====================================================================
# name: entire method + pipe on one line [ghi]
#

#--- Caspian -----------------------------------------------------------
method &foo() end | private
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: entire method + pipe on one line
#====================================================================


#====================================================================
# name: two pipes chained (nested wrapping) [ghi]
#

#--- Caspian -----------------------------------------------------------
method &whatever()
end
| autorun
| main
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: two pipes chained (nested wrapping)
#====================================================================


#====================================================================
# name: statement-level chained pipe with a pipe inside a call arg [ghi]
# left-to-right associativity, rightmost pipe outermost
#

#--- Caspian -----------------------------------------------------------
&foo | &bar(&yeah | &dude) | &gup
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: statement-level chained pipe with a pipe inside a call arg
# left-to-right associativity, rightmost pipe outermost
#====================================================================


#====================================================================
# name: paren-less bwc arg inside a pipe [ghi]
# `&yeah 'x'` in pipe LHS is a bwc call with 'x' as its arg
#

#--- Caspian -----------------------------------------------------------
&foo | &bar(&yeah 'x' | &dude) | &gup
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: paren-less bwc arg inside a pipe
# `&yeah 'x'` in pipe LHS is a bwc call with 'x' as its arg
#====================================================================


#====================================================================
# name: `A | B || C` [ghi]
# pipe binds tighter than `||`, so this groups as `(A | B) || C`
#

#--- Caspian -----------------------------------------------------------
&foo | &bar(&yeah | &dude) || &gup
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: `A | B || C`
# pipe binds tighter than `||`, so this groups as `(A | B) || C`
#====================================================================


#====================================================================
# name: `(A | B) || C` [ghi]
# explicit parens produce identical CaspJ to the paren-less form above
#

#--- Caspian -----------------------------------------------------------
(&foo | &bar(&yeah | &dude)) || &gup
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: `(A | B) || C`
# explicit parens produce identical CaspJ to the paren-less form above
#====================================================================


#====================================================================
# name: pipe expression inside a method-call arg [ghi]
# preserved as `{op: "|", left, right}` atom
#

#--- Caspian -----------------------------------------------------------
$foo.bar(&gup | &baz)
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: pipe expression inside a method-call arg
# preserved as `{op: "|", left, right}` atom
#====================================================================


# design notes for Section 17 (pipes):
#
#   Statement-leading pipe (`| bwc [args]`) is a POST-STATEMENT MODIFIER.
#   It rewrites the immediately-preceding non-comment statement in the
#   current scope by wrapping its value in a bwc call.
#
#   Shape: `[{bwc: "modifier"}, <prev_value>, <extra_args>...]`
#
#   `end | modifier` and `| modifier` (on the next line) and `end\n\n| modifier`
#   (with a blank line between) all produce identical CaspJ — whitespace and
#   newlines around the pipe are not significant.
#
#   Chained pipes wrap outward:
#     value
#     | a
#     | b
#     -> [{bwc: "b"}, [{bwc: "a"}, value]]
#
#   Comments between the value and the pipe are skipped when finding the
#   target statement; the pipe still rewrites the value, not the comment.
#
# survey material below: expression-position pipes (`$value = LHS | stage | ...`)
# are the more classical pipe form and haven't been designed yet. They need
# bwc-as-expression semantics and the `|&` sticky-null-propagation variant.
# Deferred.

# basic — first-arg form
#====================================================================
# name: pipe basic form [ghi]
# first-arg amp calls
#

#--- Caspian -----------------------------------------------------------
$value = &get_key | &normalize | &fetch
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: pipe basic form
# first-arg amp calls
#====================================================================


# with arguments on each stage
#====================================================================
# name: pipe RHS bareword-amp with paren-less args [ghi]
# `&sort 'asc'` and `&take 10` on the pipe RHS take extras alongside the piped value
#

#--- Caspian -----------------------------------------------------------
$top10 = &fetch_records() | &sort 'asc' | &take 10
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: pipe RHS bareword-amp with paren-less args
#====================================================================


#====================================================================
# name: generalized `&(EXPR)` as pipe RHS [ghi]
# `&(inner_pipe)` invokes the callable produced by the inner expression — full CaspJ preserves the nested pipe and the &-invocation; norm desugars to nested calls
#

#--- Caspian -----------------------------------------------------------
$x = &foo | &(&bear | &baz) | &gup
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: generalized `&(EXPR)` as pipe RHS
#====================================================================


# three equivalent forms all normalize to the same method-call shape
#====================================================================
# name: `&<obj>` normalizes to the object's `.call` method [ghi]
# `&` before any object means "invoke the object's `.call` method" — always,
# no runtime property lookup. Full CaspJ preserves the three surface forms
# distinctly ({var}/method-call for `$foo.call(...)`, `{amp: "foo"}` for
# `&foo`, and `{amp: {var: "foo"}}` for the `&$foo` shorthand). Norm collapses
# all three to a method_call with `fn: "call"` — the runtime sees one shape.
#

#--- Caspian -----------------------------------------------------------
$foo.call('xyz')
&foo 'xyz'
&$foo 'xyz'
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: `&<obj>` normalizes to the object's `.call` method
#====================================================================


# receiver form on the RHS
#====================================================================
# name: pipe receiver form on the RHS [ghi]
#

#--- Caspian -----------------------------------------------------------
$html = &normalize($text) | $formatter.render
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: pipe receiver form on the RHS
#====================================================================


#====================================================================
# name: pipe chain of `$obj.method` stages [ghi]
# each stage prepends the LHS as the first positional arg of the RHS
# call. `$foo.bar | $gup.zap | $bear.blah` runs as
# `$bear.blah($gup.zap($foo.bar))`.
#

#--- Caspian -----------------------------------------------------------
$foo.bar | $gup.zap | $bear.blah
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: pipe chain of `$obj.method` stages
#====================================================================


# sticky null-propagation with |&, wrapped over multiple lines

#====================================================================
# name: multi-line pipe with trailing `|&` [ghi]
# `|&` is the null-safe pipe (distinct from `|`); trailing `|` or `|&` at line end continues the statement
#

#--- Caspian -----------------------------------------------------------
$saved = &get_record 42 |&
	&validate |
	&transform |
	&save
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: multi-line pipe with trailing `|&`
#====================================================================

#====================================================================
# documentation and vibecode heredocs
#====================================================================

# documentation and vibecode are ordinary sys-methods invoked as calls.
# The heredoc form is the common one — the block body becomes the single
# arg. Runtime rule: neither method interpolates its arg even when the
# terminator is quoted (`<<"EOF"`). The transpiler doesn't enforce that
# — it emits the same `[{sys: NAME}, {value: text, dq?}]` shape as any
# other sys-call with a heredoc arg; the "no interpolation" rule is
# runtime-side.


#====================================================================
# name: documentation with plain heredoc [ghi]
# `documentation <<EOF ... EOF` — sys-method call with heredoc body as arg
#

#--- Caspian -----------------------------------------------------------
$foo = 1

documentation <<EOF
plain doc text
across two lines
EOF

$foo = 2
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: documentation with plain heredoc
#====================================================================


#====================================================================
# name: vibecode with plain heredoc [ghi]
# `vibecode <<EOF ... EOF` — same sys-call shape as documentation
#

#--- Caspian -----------------------------------------------------------
vibecode <<EOF
{"role": "example"}
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: vibecode with plain heredoc
#====================================================================


#====================================================================
# name: documentation with interpolating-terminator heredoc [ghi]
# `<<"EOF"` gets the `dq: true` flag as usual; the runtime rule is that documentation ignores it (never interpolates), but the transpiler still emits the flag as source-fidelity
#

#--- Caspian -----------------------------------------------------------
documentation <<"EOF"
literal #{do_not_interpolate}
EOF
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: documentation with interpolating-terminator heredoc
#====================================================================


#====================================================================
# name: documentation with inline string arg (parens) [ghi]
# `documentation('inline text')` — no heredoc, just a normal parens-form sys-call
#

#--- Caspian -----------------------------------------------------------
documentation('inline text')
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: documentation with inline string arg (parens)
#====================================================================


