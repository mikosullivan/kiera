#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: empty amend body
#====================================================================


# design decisions for Section 15 (classes) per Miko clarification:
#
#   `class` and `amend` are ordinary block constructs — indent-insensitive and
#   newline-agnostic like the other block BWCs; they can be written across many
#   lines or on one line. Not "multi-line required".
#
#   Class value (LONG FORM ONLY — no `class &name` sugar):
#     $foo = class ... end
#       -> ["scope", "setvar", <name>, {class: {body: [...]}}]
#
#   `amend` uses the SAME syntax as `class` — a block construct with a body:
#     $foo = amend $target ... end
#       -> ["scope", "setvar", <name>, {amend: {target: <expr>, body: [...]}}]
#   Or as a statement (probably the more common form):
#     amend $target ... end
#       -> [{amend: {target: <expr>, body: [...]}}]
#   `amend` mutates the target class rather than defining a new one.
#
#   Class-body DSL commands (`field`, `inherits`, `abstract`, plus any DSL a
#   user extends with) transpile as ordinary BWC calls:
#     [{bwc: <name>}, arg, arg, ..., {kw: [[k, v], ...]}]
#   These are BWCs in the proper sense — sigil-less command words — so the
#   `{bwc: name}` atom is honest here (distinct from `{amp: name}` for `&name`
#   sigiled calls).
#
#   There is NO `getter` command; the survey material's `getter :tag, 'default'`
#   is stale and should be removed when this section lands tests.
#
#   `method &name(...) ... end` inside a class body uses the value-atom shape
#   from Section 11:
#     [{method: {name, params, body}}]
#   Standalone at class-body position, the runtime attaches it to the class.
#   The `&` sigil on the method name is REQUIRED — same as `function &foo`
#   and `closure &bar`. `method to_string() ... end` (no sigil) is a parse
#   error; consistency across all three callable-defining keywords beats
#   saving one character.
#
#   `private`, `main`, `autorun` are FUNCTION CALLS (per Miko), not modifiers.
#   Each is called with the method value as its arg and returns the modified
#   method value. Composition is right-to-left (innermost call first):
#     autorun private method &helper() ... end
#     -> [{bwc: "autorun"},
#          [{bwc: "private"},
#            {method: {name: "helper", params: [], body: [...]}}]]
#   Equivalent explicit paren form:
#     autorun(private(method &helper() ... end))
#   Parser support for these BWC-call chains is deferred — needs the parser
#   to recognize the identifier-BWCs at statement start and consume the
#   following construct(s) as their args.
#
#   Class-field references — `@name` transpiles as a sigil-family atom
#   `{at: name}`. As a use-site reference:
#     @name           -> {at: "name"}
#     @name = 'foo'   -> ["scope", "setat", "name", {value: "foo"}]  (proposed)
#     puts @name      -> [{bwc: "puts"}, {at: "name"}]                (proposed)
#   `@name` in method-param position (`method &init(@name, @rank)`) is
#   Ruby-style auto-assignment — settled and desugared at CaspianJ level.
#   Each `@name` param strips its `@` and becomes a `{name: "name"}` param
#   entry; the method body gets an `["scope", "setat", name, {var: name}]`
#   statement prepended per @-param, in source order. Runtime doesn't need
#   to know about the sigil — the body already contains the assignments.
#   Three source forms: bare `@name`, rich metadata `@name: {default: 5}`,
#   and default-shortcut `@name: value` (maps to `{default: value}` meta).
#   Fixtures in Section 6 near the `@name` expression atom.

#====================================================================
# name: composite [ghi]
# a whole class body integrating inherits, abstract, fields (:sym + 'string' name), init with @-auto-assign, methods (plain / private / autorun+private / pipe-modified / long-form / bareword-BWC / method with subscript-set and sys-method call), inline-label comment, and a %bucket setter
#

#--- Caspian -----------------------------------------------------------
$character = class # character
	inherits %('foo.bar/person.casp'), %('foo.bar/serialize.casp')
	abstract true

	field :serial, class: :string, default: '', getset: true
	field 'serial', class: :string, default: '', getset: true

	method &init(@name, @rank)
		return null
	end

	# set a field on the class itself
	@foo = 'bar'

	method &greet()
		return @rank + ' ' + @name
	end

	private method &helper()
		return @rank
	end

	autorun(private(method &sender()
		return @rank
	end))

	method &whatever()
		return @rank
	end

	| autorun
	| main

	$to_str = method &to_string()
		return @rank + ' ' + @name
	end

	main $to_str

	method &on_close()
		%bucket['foo'] = &baz
		%self.emit @name + ' exits.'
	end
end
#--------------------------------------------------------------------

#--- CaspJ -----------------------------------------------------------

#--------------------------------------------------------------------

#
# name: composite
# a whole class body integrating inherits, abstract, fields (:sym + 'string' name), init with @-auto-assign, methods (plain / private / autorun+private / pipe-modified / long-form / bareword-BWC / method with subscript-set and sys-method call), inline-label comment, and a %bucket setter
#====================================================================


